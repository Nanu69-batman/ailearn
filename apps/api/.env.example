DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/ailearn
# Gemini key used for BOTH chat and embeddings (same value in both vars).
LLM_API_KEY=
EMBEDDING_API_KEY=
# Defaults match app/config.py; override only to pin another model.
LLM_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-2
# EMBEDDING_PROVIDER=pinecone embeds with Pinecone Inference instead (uses
# PINECONE_API_KEY; the index must be 1024-d, e.g. PINECONE_INDEX=ailearn-llama).
EMBEDDING_PROVIDER=
# Hosted transcription (Groq). Leave empty to use local faster-whisper.
GROQ_API_KEY=
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
CORS_ORIGIN=http://localhost:3000
LMS_LAUNCH_SECRET=change-me

PINECONE_API_KEY=
# Agentic chat via OpenRouter tool calling. Empty = classic Gemini pipeline.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

ALLOW_UNSIGNED_LAUNCH=true
USE_IN_MEMORY=true

# Free-tier protection for a public deployment (0 = no cap). Suggested hosted
# values: MAX_UPLOAD_MB=100, MAX_VIDEO_MINUTES=15, MAX_UPLOADS_PER_HOUR=10.
MAX_UPLOAD_MB=0
MAX_VIDEO_MINUTES=0
MAX_UPLOADS_PER_HOUR=0

# Supabase (docs/SUPABASE_PLAN.md). Features turn on only when URL + service key are set.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Only for legacy HS256 projects; leave empty to verify via JWKS.
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=media
# true in production: every personal endpoint needs a signed-in user.
AUTH_REQUIRED=false
